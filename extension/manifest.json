{
  "manifest_version": 3,
  "name": "X-HTML",
  "version": "1.0.4",
  "description": "Salvamento manual local de posts e artigos do X.",
  "permissions": [
    "storage",
    "downloads",
    "offscreen",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "optional_host_permissions": [
    "https://*.video.pscp.tv/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "X-HTML",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "save-current-post": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Salvar post atual do X"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
